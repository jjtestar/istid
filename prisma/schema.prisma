generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PLAYER
  COACH
  ADMIN
}

enum RsvpStatus {
  GOING
  NOT_GOING
  MAYBE
}

enum StickSide {
  LEFT
  RIGHT
}

enum TrainingDay {
  TUESDAY
  THURSDAY
  SATURDAY
}

enum PlayerRequestPosition {
  GOALKEEPER
  SKATER
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  passwordHash  String?
  role          Role       @default(PLAYER)
  heightCm      Int?
  weightKg      Float?
  stickSide     StickSide?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())
  isActive      Boolean    @default(true)
  accessApproved Boolean   @default(false)
  isSuperAdmin   Boolean    @default(false)
  theme          String     @default("classic")

  teams                 TeamMember[]
  trainingRegistrations TrainingRegistration[]
  matchRegistrations    MatchRegistration[]
  matchStats            MatchStat[]
  highlights            Highlight[]
  createdInviteCodes    InviteCode[] @relation("InviteCreator")
  usedInviteCode        InviteCode?  @relation("InviteUser")
  payments              Payment[]
  adminAuditLogs        AdminAuditLog[] @relation("AuditActor")
  playerRequests         PlayerRequest[] @relation("PlayerRequestCreator")
  lineupPlans            LineupPlan[]    @relation("LineupUpdater")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  season    String
  createdAt DateTime @default(now())

  members    TeamMember[]
  trainings  Training[]
  matches    Match[]
  highlights Highlight[]
  inviteCodes InviteCode[]
  payments    Payment[]
  playerRequests PlayerRequest[]
  lineupPlans    LineupPlan[]
}

model TeamMember {
  id                    String        @id @default(cuid())
  teamId                String
  userId                String
  jerseyNo              Int?
  position              String?
  playingThisSeason     Boolean?
  participatesInMatches Boolean?
  trainingDays          TrainingDay[] @default([])

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Training {
  id        String   @id @default(cuid())
  teamId    String
  startsAt  DateTime
  location  String
  notes     String?
  createdAt DateTime @default(now())

  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registrations TrainingRegistration[]
  highlights      Highlight[]
  playerRequests  PlayerRequest[]
  lineupPlan      LineupPlan?
}

model TrainingRegistration {
  id            String     @id @default(cuid())
  trainingId    String
  userId        String
  status        RsvpStatus @default(GOING)
  absenceReason String?
  attended      Boolean?
  createdAt     DateTime   @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
}

model Match {
  id        String   @id @default(cuid())
  teamId    String
  opponent  String
  isHome    Boolean  @default(true)
  startsAt  DateTime
  location  String
  homeScore Int?
  awayScore Int?
  createdAt DateTime @default(now())

  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registrations MatchRegistration[]
  stats         MatchStat[]
  highlights      Highlight[]
  playerRequests  PlayerRequest[]
  lineupPlan      LineupPlan?
}

model MatchRegistration {
  id            String     @id @default(cuid())
  matchId       String
  userId        String
  status        RsvpStatus @default(GOING)
  absenceReason String?
  createdAt     DateTime   @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model MatchStat {
  id             String @id @default(cuid())
  matchId        String
  userId         String
  goals          Int    @default(0)
  assists        Int    @default(0)
  penaltyMinutes Int    @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Highlight {
  id         String   @id @default(cuid())
  teamId     String
  authorId   String
  trainingId String?
  matchId    String?
  title      String
  url        String
  createdAt  DateTime @default(now())

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  training Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  match    Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([trainingId])
  @@index([matchId])
}

model PlayerRequest {
  id          String                 @id @default(cuid())
  teamId      String
  trainingId  String?
  matchId     String?
  position    PlayerRequestPosition
  note        String?
  createdById String
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  training  Training? @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  match     Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy User      @relation("PlayerRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId, resolvedAt])
  @@index([trainingId])
  @@index([matchId])
}

model LineupPlan {
  id          String   @id @default(cuid())
  teamId      String
  trainingId  String?  @unique
  matchId     String?  @unique
  data        Json
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  training  Training? @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  match     Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  updatedBy User      @relation("LineupUpdater", fields: [updatedById], references: [id], onDelete: Cascade)
}


model InviteCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  email       String
  teamId      String
  createdById String
  usedById    String?   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([email, expiresAt])
  @@index([teamId, createdAt])
}

model RegistrationAttempt {
  id              String    @id @default(cuid())
  keyHash         String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
}


model Payment {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  title     String
  amountOre Int
  dueDate   DateTime
  paidAt    DateTime?
  note      String?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, dueDate])
  @@index([userId, dueDate])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
}
