# Postgres connection string, e.g. from Vercel Storage (Neon) or a local Postgres.
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/istid"
# Direct (unpooled) connection, used by Prisma Migrate.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/istid"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed (prisma/seed.ts) — behövs bara för `npm run db:seed`.
# Lösenord för de seedade exempelkontona. Lämnas den tom genereras ett
# slumpmässigt lösenord som skrivs ut en gång när seeden körs.
SEED_PASSWORD=""
# Seeden raderar och skriver över data, och vägrar därför köra mot något annat
# än localhost om inte databasens värdnamn namnges här. Kör du mot en egen
# molndatabas (t.ex. Neon): sätt samma värd som i DATABASE_URL.
SEED_ALLOW_HOST=""
